msgstr "Ταχυδρομικός κώδικας"

#: gpsr/includes/class-eggl-gpsr-fields.php:34
msgid "State/Province"
msgstr "Νομός/Περιφέρεια"

#: gpsr/includes/class-eggl-gpsr-fields.php:35
msgid "Country/region"
msgstr "Χώρα/περιοχή"

#: gpsr/includes/class-eggl-gpsr-fields.php:36
msgid "Phone"
msgstr "Τηλέφωνο"

#: gpsr/includes/class-eggl-gpsr-fields.php:37
msgid "Phone 2"
msgstr "Τηλέφωνο 2"

#: gpsr/includes/class-eggl-gpsr-fields.php:38
msgid "Email"
msgstr "Email"

#: gpsr/includes/class-eggl-gpsr-fields.php:39
msgid "Website"
msgstr "Ιστότοπος"

#: gpsr/includes/class-eggl-gpsr-fields.php:46
msgid "Certificate of Analysis"
msgstr "Πιστοποιητικό ανάλυσης"

#: gpsr/includes/class-eggl-gpsr-fields.php:47
msgid "Certificate of Conformity"
msgstr "Πιστοποιητικό συμμόρφωσης"

#: gpsr/includes/class-eggl-gpsr-fields.php:48
msgid "Declaration of Conformity"
msgstr "Δήλωση συμμόρφωσης"

#: gpsr/includes/class-eggl-gpsr-fields.php:49
msgid "Instructions for Use"
msgstr "Οδηγίες χρήσης"

#: gpsr/includes/class-eggl-gpsr-fields.php:50
msgid "User Guide or Manual"
msgstr "Οδηγός χρήσης ή εγχειρίδιο"

